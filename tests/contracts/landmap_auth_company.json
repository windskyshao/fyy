    "member":        {"status": 200, "json": {"status": "OK", "ok": true, "how": "member", "stores": ["測試店"], "name": "王小明", "email": "ming@example.com"}},
    "not_staff":     {"status": 200, "json": {"status": "OK", "ok": false, "how": "", "stores": [], "name": "路人", "email": "guest@example.com"}}
  }
}
